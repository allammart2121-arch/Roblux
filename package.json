{
  "name": "bloxshop-roblox-ecommerce",
  "version": "1.0.0",
  "description": "Plataforma e-Commerce BloxShop para recargas de Robux y armas/ítems virtuales de Roblox",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "keywords": [
    "bloxshop",
    "roblox",
    "robux",
    "ecommerce",
    "wallet",
    "jwt",
    "express",
    "react"
  ],
  "author": "BloxShop Developer",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
